#cloud-config
# First-boot provisioning for the AnonView proxy host (Ubuntu 24.04).
# Rendered by Terraform (templatefile); `$${...}` is a literal shell variable.

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - fail2ban
  - unattended-upgrades
  - htop
  - jq

write_files:
  # Docker daemon: rotate container logs so the boot volume never fills up,
  # keep containers running across daemon restarts.
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" },
        "live-restore": true
      }

  # fail2ban: protect SSH (systemd backend — Ubuntu 24.04 has no auth.log by default).
  - path: /etc/fail2ban/jail.local
    permissions: "0644"
    content: |
      [DEFAULT]
      backend = systemd
      bantime = 1h
      findtime = 10m
      maxretry = 5

      [sshd]
      enabled = true

  # Host firewall. Oracle's Ubuntu images ship iptables rules that REJECT
  # everything except SSH; open 80/443 and persist the rules.
  - path: /usr/local/sbin/anonview-firewall.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      add_rule() {
        if ! iptables -C INPUT "$@" 2>/dev/null; then
          iptables -I INPUT 1 "$@"
        fi
      }
      add_rule -p tcp -m state --state NEW -m tcp --dport 80 -j ACCEPT
      add_rule -p tcp -m state --state NEW -m tcp --dport 443 -j ACCEPT
      add_rule -p udp -m udp --dport 443 -j ACCEPT
      if command -v netfilter-persistent >/dev/null 2>&1; then
        netfilter-persistent save
      fi

  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    permissions: "0644"
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:30";

runcmd:
  # 1. Host firewall (before Docker adds its own chains).
  - [bash, /usr/local/sbin/anonview-firewall.sh]
  # 2. Docker Engine + Compose plugin from Docker's official repository
  #    (multi-arch: works for arm64 and amd64).
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - bash -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  # 3. Application directory owned by the deploy user.
  - mkdir -p ${app_dir}
  - chown ubuntu:ubuntu ${app_dir}
  - chmod 750 ${app_dir}
  # 4. Small swap file on low-memory shapes (E2.1.Micro has 1 GB).
  - bash -c 'if [ "$(free -m | awk "/Mem:/ {print \$2}")" -lt 2048 ] && [ ! -f /swapfile ]; then fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile && echo "/swapfile none swap sw 0 0" >> /etc/fstab; fi'
  # 5. Security services.
  - systemctl enable --now fail2ban
  - systemctl enable --now unattended-upgrades
  - touch /var/lib/cloud/instance/anonview-ready

final_message: "AnonView host ready after $UPTIME seconds"
