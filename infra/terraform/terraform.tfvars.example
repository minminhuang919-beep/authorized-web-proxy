# Copy to terraform.tfvars only if you want to run Terraform by hand.
# ./deploy.sh generates generated.auto.tfvars.json from deploy.env instead.

tenancy_ocid        = "ocid1.tenancy.oc1..aaaaaaaa..."
compartment_ocid    = ""                      # empty = tenancy root compartment
region              = "eu-frankfurt-1"        # your HOME region
oci_profile         = "DEFAULT"
ssh_public_key      = "ssh-ed25519 AAAA... you@laptop"
ssh_allowed_cidr    = "0.0.0.0/0"             # better: "203.0.113.7/32"
instance_name       = "anonview-proxy"
instance_shape      = "VM.Standard.A1.Flex"
instance_ocpus      = 2
instance_memory_gb  = 12
boot_volume_size_gb = 50
availability_domain = ""                      # e.g. "Uocm:EU-FRANKFURT-1-AD-1"
reserved_public_ip  = true
