{
  "name": "anonview-proxy",
  "version": "1.0.0",
  "description": "Startpage Anonymous View style allowlisted web proxy with SSRF protection, admin allowlist management and Oracle Cloud deployment automation.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js | pino-pretty",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "parse5-html-rewriting-stream": "^8.0.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3"
  }
}
