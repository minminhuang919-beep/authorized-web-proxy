# ===========================================================================
# deploy.env — settings for ./deploy.sh and ./destroy.sh
# Copy to `deploy.env` (git-ignored) and edit. Leave secrets empty to have
# them generated on first deploy; they are stored only on the server.
# ===========================================================================

# --- Oracle Cloud -----------------------------------------------------------
# Profile name inside ~/.oci/config
OCI_PROFILE=DEFAULT
# Compartment to deploy into. Empty = tenancy root compartment.
OCI_COMPARTMENT_OCID=
# Region. Empty = your home region (Always Free compute only exists there).
OCI_REGION=

# --- Server ---------------------------------------------------------------
INSTANCE_NAME=anonview-proxy
# Always Free ARM shape. Fallback for tenancies without ARM capacity: VM.Standard.E2.1.Micro
INSTANCE_SHAPE=VM.Standard.A1.Flex
INSTANCE_OCPUS=2
INSTANCE_MEMORY_GB=12
BOOT_VOLUME_GB=50
# Try the x86 Always Free micro shape when no A1 capacity exists (true/false).
ALLOW_X86_FALLBACK=false
# Keep a stable public IP across instance rebuilds (true/false).
RESERVED_PUBLIC_IP=true

# --- SSH --------------------------------------------------------------------
# Private key used to reach the server (generated if it does not exist).
SSH_KEY_PATH=~/.ssh/anonview
# Who may connect to port 22. Strongly recommended: your own IP, e.g. 203.0.113.7/32
SSH_ALLOWED_CIDR=0.0.0.0/0

# --- Web / HTTPS ------------------------------------------------------------
# Domain pointing at the server (A record). Empty = plain HTTP on the IP (testing).
DOMAIN=
# E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=

# --- Application (copied to the server's .env) ------------------------------
PROXY_ALLOWED_DOMAINS=example.com,*.example.com
PROXY_UNLISTED_URL_MODE=direct
PROXY_SHOW_ALLOWLIST=true
PROXY_BANNER=true
ADMIN_USERNAME=admin
# Empty = generated on first deploy and printed once.
ADMIN_PASSWORD=
# Empty = generated on first deploy.
SESSION_SECRET=
RATE_LIMIT=300
RATE_LIMIT_WINDOW=60
ADMIN_RATE_LIMIT=10
MAX_RESPONSE_SIZE=20m
MAX_REQUEST_SIZE=2m
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10
TRANSFER_TIMEOUT=300
MAX_CONCURRENT_UPSTREAM=64
LOG_LEVEL=info

# --- Advanced ---------------------------------------------------------------
# Use an existing server instead of Terraform-managed one (./deploy.sh app).
#SERVER_IP=
