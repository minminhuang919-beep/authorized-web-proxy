# ===========================================================================
# AnonView proxy — application configuration
# Copy this file to `.env` and edit. `.env` is git-ignored; never commit it.
# Sizes are in bytes (suffixes k / m / g are accepted, e.g. 20m).
# Durations are in seconds unless stated otherwise.
# ===========================================================================

# --- Server -----------------------------------------------------------------
# Port the Node process listens on. In Docker the port stays internal and
# Caddy (the reverse proxy) is the only thing published to the Internet.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# Set to true ONLY when the app runs behind a trusted reverse proxy (Caddy in
# docker-compose, Render's edge). It makes the app read X-Forwarded-For /
# X-Forwarded-Proto. A number means "that many proxy hops in front of the app".
TRUST_PROXY=false
# Optional: header set by a trusted edge with the real client IP, used for
# rate limiting (Render/Cloudflare: true-client-ip). Leave empty otherwise.
CLIENT_IP_HEADER=

# --- Allowlist (the authorized scope) ---------------------------------------
# Comma-separated list of hostnames that may be proxied — the domains you are
# authorized to access through this proxy. Exact match only. Use a `*.` prefix
# to allow every subdomain (it does NOT include the bare domain — list that
# separately). IP addresses are never accepted.
#   example.com,*.example.com,docs.example.org
# Leave it empty and the proxy opens nothing and says so on its homepage.
# A bare `*` would authorize EVERY website (an open proxy): the blacklist and
# the SSRF checks still apply, but do not use it unless you really mean it.
PROXY_ALLOWED_DOMAINS=

# Blacklist: domains inside the authorized scope that visitors may NOT open.
# An entry also blocks all of its subdomains (example.com blocks
# www.example.com but not notexample.com). Optional reason after a pipe:
#   tracker.example|Advertising network,ads.example.com|Not permitted
PROXY_BLACKLIST=

# --- Sign-in / OAuth flows --------------------------------------------------
# Third-party sign-in cannot work through a proxy: the identity provider
# validates the origin the application is served from and the redirect URIs
# registered for its OAuth client (Google answers 403 origin_mismatch). The
# proxy refuses those flows before contacting the provider and explains why,
# rather than forging an origin or rewriting OAuth parameters.
#
# List here ONLY hosts of applications you run yourself and whose OAuth client
# you control, after registering this proxy's origin and redirect URI with the
# provider (README §6). Their sign-in pages are then proxied like any other
# page - the provider still applies all of its own checks. Same syntax as the
# allowlist (`app.example.com`, `*.corp.example`); `*` is refused.
PROXY_AUTH_FLOW_HOSTS=

# --- Site directory (shortcuts) ------------------------------------------------
# Names visitors can type instead of an address: `google` opens the configured
# destination through the proxy. Comma separated, format:
#   shortcut=destination|Name|Description
# Name and description are optional; a leading `!` disables the entry.
# Every destination must be inside the authorized scope and not blacklisted —
# a shortcut never widens access, it is validated like a typed address on
# every use. Shortcuts are letters, digits, - and _ (no dots, no spaces) and
# match case-insensitively. Encode `,` and `|` inside destinations as %2C / %7C.
#   google=https://google.com|Google|Google Search,youtube=https://youtube.com|YouTube
PROXY_SITES=

# --- Web search ------------------------------------------------------------------
# Anything typed that is not a shortcut or an address becomes a web search.
# The application never embeds a search engine: it calls an external backend
# over HTTP. `bing` is the default because it needs nothing at all — set
# SEARCH_PROVIDER=none to switch web search off instead.
#   bing     Bing's RSS result feed (?q=...&format=rss) over plain HTTPS.
#            Keyless: no account, no API key, no service to host, ~4 KB per
#            query. One page of ten results (the feed offers no more), so the
#            results page shows no "next page" link. SEARCH_PROVIDER_URL
#            optionally overrides the endpoint (default
#            https://www.bing.com/search).
#   searxng  a SearXNG instance's JSON API. SEARCH_PROVIDER_URL = its base URL.
#            docker-compose can run the official SearXNG image as a private
#            service on http://searxng:8080 (`--profile searxng`); any other
#            instance works too if `json` is listed under search.formats.
#   brave    Brave Search API (https://brave.com/search/api/): SEARCH_API_KEY
#   google   Google Programmable Search JSON API: SEARCH_API_KEY + SEARCH_ENGINE_ID
#            (the engine's "cx" id). SEARCH_PROVIDER_URL optionally overrides
#            the endpoint.
#   proxy    no API: open the query on a search website THROUGH the proxy.
#            SEARCH_PROVIDER_URL is a URL template containing {q}, and its host
#            must be in PROXY_ALLOWED_DOMAINS, e.g.
#            https://duckduckgo.com/html/?q={q}
#   none     web search off. The results page says "Web search isn't set up
#            yet"; shortcuts and website addresses keep working.
# A provider that is selected but missing a setting is NOT reported as
# "not set up": searches are attempted and report "Search is temporarily
# unavailable". The admin page /admin/search tests the backend live.
SEARCH_PROVIDER=bing
# Backend URL for the provider above (SEARXNG_URL and SEARCH_URL are still
# accepted as aliases). Leave empty for `bing`.
SEARCH_PROVIDER_URL=
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
# Secret key of the optional SearXNG service (docker compose --profile searxng).
# Any long random string; required by that service, unused otherwise.
SEARXNG_SECRET=
# Seconds to wait for the search provider.
SEARCH_TIMEOUT=10
# Searches allowed per client IP per RATE_LIMIT_WINDOW (protects API quotas).
SEARCH_RATE_LIMIT=60

# What to do with links/resources that point at domains NOT on the allowlist:
#   direct = leave the original URL so the browser loads it directly (default)
#   proxy  = route it through the proxy, which will show a "blocked" page
PROXY_UNLISTED_URL_MODE=direct

# Show the list of allowed domains on the homepage (true/false).
PROXY_SHOW_ALLOWLIST=true

# Inject a slim "viewing via proxy" banner into proxied pages (true/false).
PROXY_BANNER=true

# --- Admin ------------------------------------------------------------------
# Leave the username empty to disable the /admin area entirely.
ADMIN_USERNAME=admin
# Either a plaintext password (at least 12 characters, hashed in memory at
# start-up) ...
ADMIN_PASSWORD=
# ... or, preferably, an scrypt hash so no plaintext is stored anywhere.
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# --- Sessions ---------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -hex 32
# Required when NODE_ENV=production.
SESSION_SECRET=
# Idle lifetime of browsing/admin sessions, in seconds.
SESSION_TTL=1800
# Maximum number of concurrent sessions kept in memory.
SESSION_MAX=5000

# --- Limits -----------------------------------------------------------------
# Proxy requests allowed per client IP per window.
RATE_LIMIT=300
RATE_LIMIT_WINDOW=60
# Login attempts per client IP per window (window shared with RATE_LIMIT_WINDOW).
ADMIN_RATE_LIMIT=10
# Largest upstream response the proxy will relay (bytes).
MAX_RESPONSE_SIZE=20m
# Largest request body a client may send through the proxy (bytes).
MAX_REQUEST_SIZE=2m
# Seconds to wait for upstream response headers / between body chunks.
REQUEST_TIMEOUT=30
# Seconds allowed to establish the upstream TCP/TLS connection.
CONNECT_TIMEOUT=10
# Hard cap on the total transfer time of a single proxied response.
TRANSFER_TIMEOUT=300
# Maximum simultaneous in-flight upstream requests across all clients.
MAX_CONCURRENT_UPSTREAM=64

# --- Storage ----------------------------------------------------------------
# Where admin-managed data (scope additions, blacklist entries, shortcuts) lives:
#   file   = persisted as JSON under DATA_DIR (default; docker-compose volume)
#   memory = RAM only, lost on restart — for hosts with an ephemeral filesystem
#            such as Render's free plan (put permanent entries in
#            PROXY_ALLOWED_DOMAINS / PROXY_BLACKLIST instead)
# (ALLOWLIST_STORAGE is accepted as a legacy alias.)
ADMIN_STORAGE=file
DATA_DIR=./data

# --- Local docker-compose + Caddy only (ignored on Render) -------------------
# Public domain name pointing at your machine/server. Leave empty to serve
# plain HTTP on :80 (no certificate possible without a domain).
DOMAIN=
# E-mail used for Let's Encrypt registration / expiry notices.
ACME_EMAIL=
